# Opcionális AI-szépítés. Kulcs nélkül az alkalmazás teljes értékűen működik
# (algoritmikus válogatás és dátum/hely alapú címek).
# A kulcs CSAK a szerveren (Vercel → Project Settings → Environment Variables),
# soha nem kerül a kliens kódjába.
ANTHROPIC_API_KEY=

# Opcionális: másik modell (alapértelmezés: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Opcionális: csak erről az originről fogadjon kérést a végpont (pl. https://idokapszula.vercel.app)
# ALLOWED_ORIGIN=

# Opcionális, kliensoldali: másik AI-végpont címe (alapértelmezés: /api/enhance)
# VITE_ENHANCE_URL=
